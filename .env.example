# Optional: a free Himalayas API key gives higher documented API limits.
# Set this in your shell or Colab environment; never commit a real key.
HIMALAYAS_API_KEY=

# Optional cache directory; defaults to .opportunity-cache
OPPORTUNITY_CACHE_DIR=.opportunity-cache

# Optional comma-separated source allowlist; defaults to all enabled public sources.
OPPORTUNITY_SOURCES=

# Per-source pagination cap; default 10. Larger values increase API requests.
OPPORTUNITY_MAX_PAGES=10

# Safe per-search request budgets (all optional).
OPPORTUNITY_REMOTEJOBS_MAX_REQUESTS=60
OPPORTUNITY_JOBICY_MAX_REQUESTS=30
OPPORTUNITY_HIMALAYAS_MAX_REQUESTS=20
