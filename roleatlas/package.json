{
  "name": "roleatlas-cloudflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply roleatlas-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply roleatlas-db --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.50.0"
  }
}
